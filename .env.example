PORT=3000
APP_URL=http://localhost:3000
# Optional local HTTPS setup for phone testing on the same network:
# HTTPS=true
# SSL_CERT_PATH=C:\path\to\localhost+1.pem
# SSL_KEY_PATH=C:\path\to\localhost+1-key.pem
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Generate a separate random secret of at least 32 characters. Used only for one-time Main Admin initialization.
MAIN_ADMIN_BOOTSTRAP_SECRET=
DATABASE_URL=./data/attendance.sqlite
# Use "resend" with RESEND_API_KEY for the HTTPS API, or "smtp" for SMTP.
EMAIL_PROVIDER=smtp
EMAIL_FROM=attendance.system@example.com
# Required only when EMAIL_PROVIDER=resend. Use a sender on a verified Resend domain.
RESEND_API_KEY=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=attendance.system@example.com
SMTP_PASSWORD=your-smtp-password
# Legacy SMTP sender fallback; EMAIL_FROM takes precedence.
SMTP_FROM=attendance.system@example.com
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id
# Used only by npm run migrate:sheet. Leave blank during normal app use.
SOURCE_GOOGLE_SPREADSHEET_ID=your-current-spreadsheet-id
NEW_SPREADSHEET_NAME=Rollcall Attendance Copy
# Local development: set this to the accessible service-account JSON file path.
# Do not commit the key file. For Render, leave this blank and set GOOGLE_SERVICE_ACCOUNT_JSON.
GOOGLE_SERVICE_ACCOUNT_FILE=C:\path\to\service-account.json
# Set to the complete one-line JSON key in Render. Never commit the real value.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
TIMEZONE=Asia/Kolkata
HOLIDAYS=2026-09-06
QR_MINUTES=30
TRUST_PROXY_HOPS=0
SUBJECTS=Python,Java,HTML,CSS,JavaScript,React,Node.js,SQL,Data Structures & Algorithms,Git & GitHub
